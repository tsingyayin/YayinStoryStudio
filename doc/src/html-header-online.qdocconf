# HTML Header：Yayin Story Studio 项目文档的现代主题
#
# 这份模板不依赖 Qt 官方在线模板：那些资源会引入跨域字体、jQuery 依赖，
# 以及 /style/qt-footer.html 的 404。样式与脚本都放在 template/ 下自带，
# 由 QDoc（HTML.stylesheets / HTML.scripts）与 QDoc.py 一起复制到输出目录。
#
# 注意：QDoc 的 qdocconf 解析器会把字符串里的 $ 吃掉，因此模板内联脚本中
# 不要使用 $（本项目不使用 jQuery，脚本都在 scripts/yss.js 里）。

# 需要复制到输出目录的静态资源
# （logo.png 由 QDoc.py 的 copyFolder 复制到 images/，不必放这里，
#   否则会在输出目录的 style/ 下多出一份副本）
HTML.stylesheets = template/style/yss.css

qhp.extraFiles += style/yss.css \
                  images/logo.png

# <head> 中的样式与脚本。深浅色选择必须在样式表生效前应用，避免闪白；
# 入场动效的开关类同理，必须在首帧之前挂上，否则正文会先完整显示再闪一下。
HTML.headerstyles = \
    "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n" \
    "  <link rel=\"stylesheet\" type=\"text/css\" href=\"style/yss.css\" />\n" \
    "  <link rel=\"icon\" type=\"image/png\" href=\"images/logo.png\" />\n" \
    "  <script type=\"text/javascript\">\n" \
    "    try {\n" \
    "      var yssTheme = localStorage.getItem(\"yss-doc-theme\");\n" \
    "      if (yssTheme === \"dark\" || yssTheme === \"light\") {\n" \
    "        document.documentElement.setAttribute(\"data-theme\", yssTheme);\n" \
    "      }\n" \
    "    } catch (e) {}\n" \
    "    // 入场动效：系统没要求减少动态效果时，先挂上动效类；\n" \
    "    // 万一副脚本没跑起来（被拦、加载失败），2 秒后自动解除，内容始终可见。\n" \
    "    try {\n" \
    "      if (!window.matchMedia || !window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches) {\n" \
    "        document.documentElement.classList.add(\"yss-motion\");\n" \
    "        window.setTimeout(function () {\n" \
    "          if (!window.__yssMotionReady) {\n" \
    "            document.documentElement.classList.remove(\"yss-motion\");\n" \
    "          }\n" \
    "        }, 2000);\n" \
    "      }\n" \
    "    } catch (e) {}\n" \
    "  </script>\n"

HTML.headerscripts = \
    "  <script type=\"text/javascript\" src=\"scripts/yss.js\" defer></script>\n"

HTML.scripts = template/scripts/yss.js

HTML.endheader = \
    "</head>\n"

# 顶栏：品牌 + 模块导航 + 深浅色/目录按钮。
#
# 导航里的模块入口由 QDoc.py 在构建时按 doc/src/module.qdoc 里的 \module 声明
# 重新生成（模块页文件名 = 模块名小写 + "-module.html"），下面这份只是没跑到
# 那一步时的兼底，两者内容应当一致。普通文档页（如 Python 工具、插件开发）
# 不是模块，不列在这里，它们放在页脚和各页正文的链接里。
# 顶栏之后紧接 QDoc 注入的面包屑（navigationbar 里的 li 由 QDoc 生成）。
HTML.postheader = \
    "<body>\n" \
    "<a class=\"yss-skip\" href=\"#maincontent\">跳到正文</a>\n" \
    "<header class=\"yss-topbar\">\n" \
    "  <div class=\"yss-topbar__inner\">\n" \
    "    <a class=\"yss-brand\" href=\"index.html\">\n" \
    "      <img src=\"images/logo.png\" alt=\"Yayin Story Studio\" />\n" \
    "      <span>Yayin Story Studio 项目文档</span>\n" \
    "    </a>\n" \
    "    <nav class=\"yss-nav\">\n" \
    "      <a href=\"index.html\">主页</a>\n" \
    "      <a href=\"visindigo-module.html\">Visindigo</a>\n" \
    "      <a href=\"ysscore-module.html\">YSSCore</a>\n" \
    "      <a href=\"yayinstorystudio-module.html\">YayinStoryStudio</a>\n" \
    "      <a href=\"aserstudio-module.html\">ASERStudio</a>\n" \
    "      <a href=\"yssfileext-module.html\">YSSFileExt</a>\n" \
    "    </nav>\n" \
    "    <div class=\"yss-tools\">\n" \
    "      <button id=\"yss-theme-toggle\" class=\"yss-iconbtn\" type=\"button\" title=\"切换深浅色\" aria-label=\"切换深浅色\">☾</button>\n" \
    "      <button id=\"yss-menu-toggle\" class=\"yss-iconbtn yss-menu-toggle\" type=\"button\" title=\"目录\" aria-label=\"目录\" aria-expanded=\"false\">☰</button>\n" \
    "    </div>\n" \
    "  </div>\n" \
    "</header>\n" \
    "<div class=\"main\">\n" \
    "<div class=\"main-rounded\">\n" \
    "<div class=\"navigationbar\">\n" \
    "    <ul>\n"

HTML.postpostheader = \
    "    </ul>\n" \
    "</div>\n" \
    "<div class=\"content\">\n" \
    "    <div class=\"line\">\n" \
    "        <div class=\"content mainContent\">\n"

HTML.prologue = \
    "<div class=\"context\" id=\"maincontent\">\n"
