include(qt-html-templates-online.qdocconf)
include(D:\Qt\Docs\Qt-6.10.3\global\fileextensions.qdocconf)
include(D:\Qt\Docs\Qt-6.10.3\global\qt-cpp-defines.qdocconf)

project = Yayin Story Studio

# 文档站对外的基地址。写入 .index 文件，供其它 QDoc 工程跨站链接
# （ASER Studio 的文档依赖本工程的 index，链接会指向这里）。
url = http://prts.site

indexes = \
	D:/Qt/Docs/Qt-6.10.3/qtcore/qtcore.index \
	D:/Qt/Docs/Qt-6.10.3/qtgui/qtgui.index \
	D:/Qt/Docs/Qt-6.10.3/qtwidgets/qtwidgets.index \
	D:/Qt/Docs/Qt-6.10.3/qtnetwork/qtnetwork.index
	
depends = *

includepaths += .\
	.. \
	../../src/Visindigo \
	../../src/YSSCore \
	../../src/VIAgent \
	../../src/YayinStoryStudio \
	../../src/Plugin_YSSFileExt \
	D:/Qt/6.10.3/msvc2022_64/include/QtCore \
	D:/Qt/6.10.3/msvc2022_64/include/QtGui \
	D:/Qt/6.10.3/msvc2022_64/include/QtWidgets \
	D:/Qt/6.10.3/msvc2022_64/include/QtNetwork \
	D:/Qt/Docs/Qt-6.10.3

headerdirs += .\
	.. \
	../../src/Visindigo \
	../../src/YSSCore \
	../../src/VIAgent \
	../../src/YayinStoryStudio \
	../../src/Plugin_YSSFileExt \
	D:/Qt/6.10.3/msvc2022_64/include/QtCore \
	D:/Qt/6.10.3/msvc2022_64/include/QtGui \
	D:/Qt/6.10.3/msvc2022_64/include/QtWidgets \
	D:/Qt/6.10.3/msvc2022_64/include/QtNetwork


sourcedirs +=.\
	.. \
	../../src \
	../../src/Visindigo \
	../../src/YSSCore \
	../../src/VIAgent \
	../../src/YayinStoryStudio \
	../../src/Plugin_YSSFileExt

headers.fileextensions  = "*.h *.hpp"
sources.fileextensions  = "*.cpp *.qml *.qdoc"

syntaxhighlighting = true

outputdir   = ../html

sourceencoding = UTF-8

outputencoding = UTF-8

naturallanguage = zh-Hans

exampledirs = ./examples

imagedirs   = ./images
