  <!--
    可选：ASER Studio 与 VisindigoSpine 已剥离到同级仓库（../ASER_Studio、../VisindigoSpine）。
    在“项目属性 → 配置属性 → 生成事件”中用标准复选框控制，两个开关按配置分别保存：
      - 生成前事件 → 在生成中使用：控制 ASER Studio 自动构建（跟随当前配置 Debug/Release）
      - 生成后事件 → 在生成中使用：控制 VisindigoSpine 自动构建
    VisindigoSpine 只提供 Release 构建，因此无论当前配置如何都按 Release 构建。
    当前 Release 的生成后事件是关闭的，需要更新 Spine 插件时再把复选框勾上。
    外部克隆者没有这些仓库时事件会静默跳过（命令里带 if exist 判断）。
    工程路径可用 /p:ASERStudioProject=...、/p:VisindigoSpineSolution=... 覆盖。
  -->
  <PropertyGroup>
    <YSSRepoRoot>$(MSBuildProjectDirectory)\..\..</YSSRepoRoot>
    <ASERStudioProject Condition="'$(ASERStudioProject)' == ''">$(YSSRepoRoot)\..\ASER_Studio\Plugin_ASERStudio\Plugin_ASERStudio.vcxproj</ASERStudioProject>
    <VisindigoSpineSolution Condition="'$(VisindigoSpineSolution)' == ''">$(YSSRepoRoot)\..\VisindigoSpine\VisindigoSpine.slnx</VisindigoSpineSolution>
  </PropertyGroup>
  <Target Name="DeriveLibAfterBuild" AfterTargets="Build">
    <Exec Command="python.exe &quot;$(SolutionDir)pytools\deriveLib.py&quot;" />
  </Target>
</Project>