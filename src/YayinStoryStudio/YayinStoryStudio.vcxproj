  <!--
    Exec 任务默认按宿主控制台的 ANSI 代码页（简体中文系统为 936）解码子进程输出，
    而 MSBuild 子进程在输出被重定向时一律写 UTF-8，直接转发就会变成乱码。
    这里显式声明 StdOutEncoding/StdErrEncoding，让 VS 生成输出按 UTF-8 解码。
  -->
  <ItemDefinitionGroup>
    <PreBuildEvent>
      <Command>if exist "$(ASERStudioProject)" "$(MSBuildBinPath)\MSBuild.exe" "$(ASERStudioProject)" /t:Build /nologo /v:m /p:Configuration=$(Configuration) /p:Platform=$(Platform) /p:YSSRoot=$(SolutionDir). /p:YSSLibDir=$(SolutionDir)$(Platform)\$(Configuration) "/p:QtMsBuild=$(QtMsBuild)"</Command>
      <Message>Building ASER Studio plugin</Message>
      <StdOutEncoding>UTF-8</StdOutEncoding>
      <StdErrEncoding>UTF-8</StdErrEncoding>
    </PreBuildEvent>
    <PostBuildEvent>
      <Command>if exist "$(VisindigoSpineSolution)" "$(MSBuildBinPath)\MSBuild.exe" "$(VisindigoSpineSolution)" /t:Build /nologo /v:m /p:Configuration=Release /p:Platform=$(Platform) /p:YSSRoot=$(SolutionDir). "/p:QtMsBuild=$(QtMsBuild)"</Command>
      <Message>Building VisindigoSpine plugin (Release only)</Message>
      <StdOutEncoding>UTF-8</StdOutEncoding>
      <StdErrEncoding>UTF-8</StdErrEncoding>
    </PostBuildEvent>
  </ItemDefinitionGroup>
